datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id                  String   @id @default(uuid())
  name                String
  privyOrgId         String?  @unique
  walletAddress       String
  maxReleaseLimitUsdc Decimal  @default(5000) @db.Decimal(18, 6)
  createdAt           DateTime @default(now())
  users               User[]
  jobs                Job[]

  @@map("organizations")
}

model User {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  privyUserId    String        @unique
  walletAddress  String
  name           String?
  email          String?       @unique
  password       String?
  role           String        @default("CLIENT") // CLIENT, FREELANCER, ADMIN
  createdAt      DateTime      @default(now())
  clientJobs     Job[]         @relation("ClientJobs")
  freelancerJobs Job[]         @relation("FreelancerJobs")
  paymentIntents PaymentIntent[]

  @@map("users")
}

model Job {
  id                      String          @id @default(uuid())
  title                   String
  description             String?
  clientId                String
  client                  User            @relation("ClientJobs", fields: [clientId], references: [id])
  organizationId          String?
  organization            Organization?   @relation(fields: [organizationId], references: [id])
  freelancerId            String?
  freelancer              User?           @relation("FreelancerJobs", fields: [freelancerId], references: [id])
  freelancerPayoutAddress String
  amountUsdc              Decimal         @db.Decimal(18, 6)
  status                  String          @default("CREATED") // CREATED, ACCEPTED, FUNDED, WORK_SUBMITTED, APPROVED, COMPLETED, REFUNDED
  escrowId                String?         // onchain bytes32 escrow hash
  submissionUrl           String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  paymentIntents          PaymentIntent[]
  auditEvents             AuditEvent[]
  transactions            Transaction[]

  @@map("jobs")
}

model PaymentIntent {
  id                         String         @id @default(uuid())
  jobId                      String
  job                        Job            @relation(fields: [jobId], references: [id])
  clientId                   String
  client                     User           @relation(fields: [clientId], references: [id])
  recipientAddress           String
  amountUsdc                 Decimal        @db.Decimal(18, 6)
  riskLevel                  String         // LOW, MEDIUM, HIGH
  requiresHumanVerification  Boolean        @default(false)
  signalHash                 String         // cryptographic binding hash
  status                     String         @default("PENDING") // PENDING, VERIFIED, EXECUTED, BLOCKED, EXPIRED
  expiresAt                  DateTime
  createdAt                  DateTime       @default(now())
  verifications              Verification[]
  transactions               Transaction[]
  auditEvents                AuditEvent[]

  @@map("payment_intents")
}

model Verification {
  id                String        @id @default(uuid())
  paymentIntentId   String
  paymentIntent     PaymentIntent @relation(fields: [paymentIntentId], references: [id])
  nullifierHash     String
  merkleRoot        String
  verificationLevel String        // 'selfie', 'orb', 'device'
  verifiedAt        DateTime      @default(now())
  status            String        // VALID, REPLAY_DETECTED, EXPIRED, FAILED

  @@unique([paymentIntentId, nullifierHash])
  @@map("verifications")
}

model Transaction {
  id              String         @id @default(uuid())
  jobId           String
  job             Job            @relation(fields: [jobId], references: [id])
  paymentIntentId String?
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id])
  txHash          String?        @unique
  chainId         Int            @default(5042002) // Arc Testnet
  action          String         // FUND, RELEASE, REFUND
  status          String         @default("PENDING") // PENDING, CONFIRMED, FAILED
  blockNumber     BigInt?
  createdAt       DateTime       @default(now())

  @@map("transactions")
}

model AuditEvent {
  id              String         @id @default(uuid())
  jobId           String
  job             Job            @relation(fields: [jobId], references: [id])
  paymentIntentId String?
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id])
  eventType       String
  actorAddress    String?
  actorRole       String?
  metadata        Json           @default("{}")
  timestamp       DateTime       @default(now())

  @@map("audit_events")
}
